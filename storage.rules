rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars - users can only upload to their own folder
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true; // Anyone can read avatars
      allow write: if request.auth != null && request.auth.uid == userId; // Only user can upload to their own folder
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
